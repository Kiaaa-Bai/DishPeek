    "Pick a mood. We'll suggest up to 3 from what people order here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Such dir eine Stimmung aus. Wir schlagen bis zu 3 Gerichte vor, basierend auf dem, was hier bestellt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué te apetece. Te sugerimos hasta 3 platos según lo que pide la gente aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une envie. Nous vous proposons jusqu’à 3 plats d’après les commandes ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分を選んでください。このお店でよく注文されている料理から、最大3品をおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기분을 골라 보세요. 이곳에서 많이 주문하는 메뉴 중 최대 3개를 추천해 드려요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกอารมณ์ที่อยากกิน เราจะแนะนำไม่เกิน 3 เมนูจากที่คนสั่งกันที่นี่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn khẩu vị bạn muốn. Chúng tôi sẽ gợi ý tối đa 3 món dựa trên những gì mọi người hay gọi ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选一种想吃的口味，我们会根据这里的点单推荐最多 3 道菜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選一種想吃的口味，我們會根據這裡的點單推薦最多 3 道菜。"
          }
        }
      }
