    "No dishes yet. Tap a line on the menu, then Add to order." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Gerichte. Tippe auf eine Zeile in der Speisekarte und dann auf „Zur Bestellung hinzufügen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay platos. Toca una línea del menú y luego «Añadir al pedido»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun plat pour l’instant. Touchez une ligne du menu, puis « Ajouter à la commande »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ料理がありません。メニューの行をタップして、「注文に追加」を押してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 메뉴가 없어요. 메뉴판에서 한 줄을 누른 다음 ‘주문에 추가’를 눌러 보세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีเมนู แตะที่บรรทัดในเมนู แล้วแตะ “เพิ่มในออเดอร์”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có món nào. Chạm vào một dòng trên thực đơn, rồi chọn “Thêm vào đơn”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有菜品。点一下菜单上的某一行，再点“加入点单”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有餐點。點一下菜單上的某一行，再點「加入點單」。"
          }
        }
      }
    },
