        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · %2$@\n%3$@ en Google Maps, %4$lld reseña\n\nLas fotos y «Popular aquí» vendrán de este lugar."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · %2$@\n%3$@ en Google Maps, %4$lld reseñas\n\nLas fotos y «Popular aquí» vendrán de este lugar."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · %2$@\n%3$@ sur Google Maps, %4$lld avis\n\nLes photos et « Populaire ici » viendront de ce lieu."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · %2$@\n%3$@ sur Google Maps, %4$lld avis\n\nLes photos et « Populaire ici » viendront de ce lieu."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@\nGoogle Mapsの評価は%3$@、レビューは%4$lld件\n\n写真と「この店で人気」は、この場所の情報をもとに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@\nGoogle Maps 평점 %3$@, 리뷰 %4$lld개\n\n사진과 ‘이곳에서 인기’는 이 장소 기준으로 보여 드려요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@\nGoogle Maps ให้คะแนน %3$@ จากรีวิว %4$lld รายการ\n\nรูปภาพและ “ยอดนิยมที่นี่” จะมาจากสถานที่นี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@\n%3$@ trên Google Maps, %4$lld đánh giá\n\nẢnh và mục “Phổ biến ở đây” sẽ lấy từ địa điểm này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@\nGoogle Maps 评分 %3$@，%4$lld 条评价\n\n照片和“本店热门”将来自这个地点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@\nGoogle Maps 評分 %3$@，%4$lld 則評論\n\n照片和「本店熱門」將來自這個地點。"
          }
        }
      }
    },
