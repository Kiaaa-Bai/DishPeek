    "%@ · %@\n%@ on Google Maps, %lld reviews\n\nPhotos and Popular here will come from this place." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · %2$@\n%3$@ auf Google Maps, %4$lld Bewertung\n\nFotos und „Hier beliebt“ stammen von diesem Ort."
                }
              },
              "other" : {
                "stringUnit" : {
