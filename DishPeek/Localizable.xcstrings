          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcaremos esos platos en todos los menús. Puedes cambiarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous signalerons ces plats sur chaque menu. Vous pourrez modifier cela plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのメニューでも、該当する料理に印を付けます。あとで変更できます。"
          }
